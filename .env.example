# LinkedIn app credentials (https://developer.linkedin.com/apps)
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
# Must match the redirect URL registered in your LinkedIn app's Auth tab
LINKEDIN_REDIRECT_URI=http://localhost:8913/callback

# AI agent: "opencode" (recommended, free models) or "claude" for Claude Code
OPENCODE_CMD=opencode
# Any model your CLI supports; comment out to use the CLI's default model
# Run `opencode models` to list options
OPENCODE_MODEL=opencode/x-preview-f-free

# Only use news stories newer than this many hours
NEWS_MAX_AGE_HOURS=72
