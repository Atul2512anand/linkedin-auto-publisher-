# LinkedIn app credentials (https://developer.linkedin.com/apps)
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
# Must match the redirect URL registered in your LinkedIn app's Auth tab
LINKEDIN_REDIRECT_URI=http://localhost:8913/callback

# ---- Where posts go -------------------------------------------------------
# person       -> your personal profile (default, instant setup)
# organization -> a company page you admin (needs Community Management API)
LINKEDIN_AUTHOR_TYPE=person
# Only needed when LINKEDIN_AUTHOR_TYPE=organization (numeric page ID,
# printed by auth_linkedin.py after login, or visible in the orgAcls call)
#LINKEDIN_ORGANIZATION_ID=123456789

# ---- AI agent -------------------------------------------------------------
# "opencode" (recommended, free models) or "claude" for Claude Code
OPENCODE_CMD=opencode
# Any model your CLI supports; comment out to use the CLI's default model
# Run `opencode models` to list options
OPENCODE_MODEL=opencode/x-preview-f-free

# Only use news stories newer than this many hours
NEWS_MAX_AGE_HOURS=72

# ---- Visuals --------------------------------------------------------------
# off      -> text-only posts (default, zero risk)
# image    -> AI hero image (Pollinations.ai, free, no key) attached to post
# carousel -> branded PDF carousel built from the post content
VISUAL_MODE=off
# Your name/handle printed on carousel slides
BRAND_NAME=Your Name
# Hex color for slide accents (bars, numbers, dots)
ACCENT_COLOR=#22D3EE
